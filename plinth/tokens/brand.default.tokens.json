      },
      "displayL": {
        "min": {
          "$type": "dimension",
          "$value": "{preset.typeContrast.standard.displayL.min}"
        },
        "max": {
          "$type": "dimension",
          "$value": "{preset.typeContrast.standard.displayL.max}"
        }
      }
    },
    "density": {
      "desktop": {
        "$type": "number",
        "$value": "{preset.density.standard.desktop}"
