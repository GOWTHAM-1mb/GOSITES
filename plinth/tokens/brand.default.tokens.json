      "lift": {
        "$type": "color",
        "$value": "{preset.accent.laterite.lift}"
      },
      "tint": {
        "$type": "color",
        "$value": "{preset.accent.laterite.tint}"
      },
      "deep": {
        "$type": "color",
        "$value": "{preset.accent.laterite.deep}"
      }
    },
    "displayFace": {
      "family": {
        "$type": "fontFamily",
        "$value": "{preset.displayFace.literary.family}"
