        "$value": "{preset.temperature.warm.neutral.300}"
      },
      "400": {
        "$type": "color",
        "$value": "{preset.temperature.warm.neutral.400}"
      },
      "500": {
        "$type": "color",
        "$value": "{preset.temperature.warm.neutral.500}"
      },
      "600": {
        "$type": "color",
        "$value": "{preset.temperature.warm.neutral.600}"
      },
      "700": {
        "$type": "color",
        "$value": "{preset.temperature.warm.neutral.700}"
