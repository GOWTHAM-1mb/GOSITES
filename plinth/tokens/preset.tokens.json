    "typeContrast": {
      "quiet": {
        "displayXl": {
          "min": {
            "$type": "dimension",
            "$value": {
              "value": 48,
              "unit": "px"
            }
          },
          "max": {
            "$type": "dimension",
            "$value": {
              "value": 82,
              "unit": "px"
            }
          },
          "$extensions": {
            "in.plinth": {
              "fluid": {
                "minViewport": 375,
                "maxViewport": 1440
              },
              "css": "clamp(48px, 36.028px + 3.192vw, 82px)"
            }
          }
        },
        "displayL": {
          "min": {
            "$type": "dimension",
            "$value": {
