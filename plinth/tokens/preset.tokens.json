    "displayFace": {
      "literary": {
        "family": {
          "$type": "fontFamily",
          "$value": "{font.family.newsreader}"
        },
        "scale": {
          "$type": "number",
          "$value": 1
        },
        "tracking": {
          "$type": "dimension",
          "$value": {
            "value": -0.025,
            "unit": "rem"
          },
          "$description": "Applied as em in CSS."
        },
        "weight": {
          "$type": "fontWeight",
          "$value": 300
        },
        "$extensions": {
          "in.plinth": {
            "emphasis": "italic"
          }
        }
      },
      "technical": {
        "family": {
