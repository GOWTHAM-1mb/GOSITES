    "composition": {
      "$description": "Structural presets; no token values. Selected via data-header / data-hero / data-index and the matching component variant.",
      "$extensions": {
        "in.plinth": {
          "header": [
            "masthead",
            "axial",
            "rail"
          ],
          "hero": [
            "plate",
            "statement",
            "index"
          ],
          "index": [
            "ledger",
            "staggered",
            "sheet"
          ]
        }
      }
    },
    "ground": {
      "$description": "lime | ink — selects the semantic mode for the whole site.",
      "$extensions": {
        "in.plinth": {
          "values": [
